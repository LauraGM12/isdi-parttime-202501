{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node .",
    "inspect": "node --inspect-brk .",
    "test": "mocha **/*.spec.js --recursive",
    "test:watch": "mocha **/*.spec.js --recursive --watch",
    "test:coverage:html": "c8 --reporter=html mocha **/*.spec.js --recursive",
    "test-coverage": "npx c8 --exclude='logic/games/**' --exclude='logic/**/*.spec.js' --exclude='logic/index.js' --exclude='logic/**/index.js' --reporter=text --reporter=html mocha logic/**/*.spec.js --ignore='logic/games/**/*.js --ignore='logic/games/**/*.spec.js"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "bcryptjs": "^3.0.2",
    "common": "file:../common",
