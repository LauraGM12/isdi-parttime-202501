# Variables de entorno para LootRate Backend

# Puerto del servidor
PORT = 3001

# Conexión a MongoDB (Mongoose)
MONGODB_URL = mongodb://localhost:27017
MONGO_DB = LootRate
MONGO_DB_TEST = LootRate-test

# Clave secreta para JWT
JWT_SECRET=tu_clave_secreta_muy_segura_para_lootrate
JWT_MINUTES_TIMEOUT = 60000000000

# API Key para RAWG API
RAWG_API_KEY = mi_api_key_de_rawg

# Configuración de Mongoose
MONGOOSE_DEBUG = 'true'